# Optional. Copy to .env.local for development only.
# A free Jamendo client ID (https://developer.jamendo.com/v3.0) enables full-length Jamendo streaming.
# NOTE: anything prefixed VITE_ is bundled into the public JS. Do NOT put a private secret here.
# Most people should skip this and paste their own ID in Settings → Music sources instead —
# it then stays in their own browser and never reaches the build.
VITE_JAMENDO_CLIENT_ID=
